    switch(_id) {
        case 1: return {ground:spr_ground_marsh,blend:make_color_rgb(190,200,190),road:[make_color_rgb(14,22,20),make_color_rgb(50,58,50),make_color_rgb(70,76,62)],stone:[make_color_rgb(54,62,54),make_color_rgb(82,88,74)],fog:[make_color_rgb(150,190,150),make_color_rgb(120,165,140)],fog_a:[0.16,0.11],mote:[make_color_rgb(150,230,120),make_color_rgb(92,207,204)],weather:3,tree:make_color_rgb(170,195,165)};
