/// Story mode (1.4): chapter rules, texts, progress file, cutscenes and the chapter-select screen.
/// Maps and themes live in scr_maps (generated by tools/story_maps.py).
#macro WP_CHAPTERS 5

// ------------------------------------------------------------------------------------------ rules
// Rules of the current run. Survival (mode 0) is exactly the 1.3 campaign: 8 waves, boss on wave 8.
//   map     map id (0 = the room-authored forest map)
//   total   number of waves        gold    starting aether
//   hpmult  enemy HP multiplier    offset  added to the wave number for enemy strength and composition
//   flavor  enemy mix (0 balanced, 1 brutes, 2 runners, 3 brutes+runners, 4 everything)
//   boss    waves that end with a Bone Colossus
function wp_rules_for(_mode,_chapter) {
    if(_mode!=1)return {map:0,total:8,gold:280,hpmult:1,offset:0,flavor:0,boss:[8]};
    switch(clamp(_chapter,0,WP_CHAPTERS-1)) {
        case 0: return {map:0,total:5,gold:300,hpmult:.85,offset:0,flavor:0,boss:[]};
        case 1: return {map:1,total:6,gold:420,hpmult:.85,offset:1,flavor:1,boss:[]};
        case 2: return {map:2,total:7,gold:320,hpmult:1.2,offset:1,flavor:2,boss:[]};
        case 3: return {map:3,total:8,gold:340,hpmult:1.15,offset:1,flavor:3,boss:[8]};
    }
    return {map:4,total:10,gold:380,hpmult:1.8,offset:2,flavor:4,boss:[5,10]};
}
function wp_rules_set(_mode,_chapter) {
    global.mode=_mode;global.chapter=_chapter;
    global.rules=wp_rules_for(_mode,_chapter);
}
// Difficulty step of a wave (wave number plus the chapter offset).
function wp_wave_eff(_wave) { return _wave+global.rules.offset; }

// ------------------------------------------------------------------------------------------ names
function wp_roman(_c) { return ["I","II","III","IV","V"][clamp(_c,0,WP_CHAPTERS-1)]; }
function wp_chapter_title(_c) {
    return [wp_tr("The Last Ward","Останній Оберіг"),wp_tr("Mirewood Ford","Туманний Брід"),wp_tr("Frostline Pass","Крижаний Перевал"),wp_tr("The Ashen Citadel","Попелясте Місто"),wp_tr("The Hollow Throne","Порожній Трон")][clamp(_c,0,WP_CHAPTERS-1)];
}
function wp_chapter_blurb(_c) {
    switch(clamp(_c,0,WP_CHAPTERS-1)) {
        case 0: return wp_tr("The first night at the last ward. Learn the road, raise your first towers and keep the crystal burning.","Перша ніч біля останнього оберегу. Вивчіть дорогу, зведіть перші вежі й збережіть кристал.");
        case 1: return wp_tr("A winding road through the marsh. Brutes soak up damage while an old relay-stone slowly wakes.","Звивиста дорога крізь болото. Громили витримують удари, поки прокидається давній камінь-ретранслятор.");
        case 2: return wp_tr("A frozen switchback pass. Runners strike first and fast; frost wards are worth their weight in aether.","Крижаний перевал із серпантином. Бігуни б'ють першими й швидко; крижані обереги тут безцінні.");
        case 3: return wp_tr("The ruins of the first ward. A mixed horde, and the Bone Colossus waits at the end of the eighth wave.","Руїни першого оберегу. Змішана орда, а наприкінці восьмої хвилі на вас чекає Кістяний колос.");
    }
    return wp_tr("The source of the Wire. A spiral road, ten waves and two Colossi. Then the choice that ends the story.","Витік Дроту. Дорога-спіраль, десять хвиль і двоє Колосів. А далі — вибір, що завершить історію.");
}
// Speakers: 0 chronicle, 1 Orest (voice of the crystal), 2 Marena (the Hollow Captain), 3 the Warden, 4 title card.
function wp_speaker(_who) {
    switch(_who) {
        case 1: return {name:wp_tr("Orest","Орест"),color:global.col.teal};
        case 2: return {name:wp_tr("Marena","Марена"),color:global.col.purple};
        case 3: return {name:wp_tr("The Warden","Вартовий"),color:global.col.text};
    }
    return {name:wp_tr("The Chronicle","Хроніка"),color:merge_color(global.col.gold,c_white,.15)};
}
function wp_line(_who,_text) { return {who:_who,text:_text}; }

// ------------------------------------------------------------------------------------------ the story
// Dialogue of a chapter. _kind: "brief" (before the battle), "epi" (after the victory) or "end" (_c = 1 relight, 2 release).
function wp_story_lines(_kind,_c) {
    if(_kind=="brief") switch(_c) {
        case 0: return [
            wp_line(0,wp_tr("Five wards once ringed the Valley of Dawn, bound together by the Wire — a thread of aether no army could cross. Four have gone dark. The fifth still burns.","П'ять оберегів колись оточували Долину Світанку, зв'язані Дротом — ниткою ефіру, яку не міг перетнути жоден військовий похід. Чотири згасли. П'ятий ще горить.")),
            wp_line(1,wp_tr("Warden, can you hear me? I am Orest, keeper of this crystal. I have counted the dead on the road. There are more than all four fallen wards ever saw.","Вартовий, ти мене чуєш? Я — Орест, хранитель цього кристала. Я полічив мертвих на дорозі. Їх більше, ніж бачили разом усі чотири оберіги, що впали.")),
            wp_line(1,wp_tr("They do not hunt the living. They march for the core. Hold the road, and do not let them touch the light.","Вони не полюють на живих. Вони йдуть по ядро. Тримай дорогу й не дозволяй їм торкнутися світла.")),
            wp_line(3,wp_tr("Then they will have to come through me.","Тоді їм доведеться пройти крізь мене."))];
        case 1: return [
            wp_line(0,wp_tr("The Wire crosses the marsh at Mirewood Ford, where an old relay-stone waits to be lit again. Fog hides the road, and the dead hide in the fog.","Дріт перетинає болото біля Туманного Броду, де давній камінь-ретранслятор чекає, щоб його запалили знову. Туман ховає дорогу, а мерці ховаються в тумані.")),
            wp_line(1,wp_tr("I will pour aether down the Wire to the relay. It takes time. Keep the stone standing until the light catches.","Я спрямую ефір по Дроту до ретранслятора. Це забере час. Тримай камінь, доки світло не розгориться.")),
            wp_line(3,wp_tr("Where do they come from?","Звідки вони йдуть?")),
            wp_line(1,wp_tr("From the east. Something very old walks behind them.","Зі сходу. За ними йде щось дуже давнє."))];
        case 2: return [
            wp_line(0,wp_tr("North of the marsh the Wire climbs into the frozen pass. Beyond it lie the ruins of the first ward — the first to fall, and the last place anyone ever returned from.","На північ від болота Дріт підіймається в крижаний перевал. За ним лежать руїни першого оберегу — першого, що впав, і місця, звідки ніхто не повертався.")),
            wp_line(2,wp_tr("Turn back. I hear every step you take in the snow.","Поверни назад. Я чую кожен твій крок на снігу.")),
            wp_line(1,wp_tr("She is closer than I feared. The cold does not slow the dead. Expect runners first.","Вона ближче, ніж я боявся. Холод не сповільнює мертвих. Чекай бігунів першими."))];
        case 3: return [
            wp_line(0,wp_tr("The first ward fell without a siege. Its garrison simply rose. What is left is a city of ash and a crystal gone dark.","Перший оберіг упав без облоги. Його гарнізон просто підвівся. Лишилося місто з попелу й згаслий кристал.")),
            wp_line(2,wp_tr("Welcome home. I was Captain here, before I understood what the Wall costs.","Ласкаво прошу додому. Колись я була тут капітаном, поки не зрозуміла, чого коштує Стіна.")),
            wp_line(1,wp_tr("Marena. Captain of the first ward. We believed she died the night it fell.","Марена. Капітан першого оберегу. Ми вважали, що вона загинула тієї ночі, коли він упав.")),
            wp_line(2,wp_tr("I did not die. I listened. The crystals scream, warden, every night, for a thousand years.","Я не загинула. Я прислухалася. Кристали кричать, вартовий, щоночі, тисячу років."))];
        case 4: return [
            wp_line(0,wp_tr("At the source of the Wire stands a throne of dead stone, beneath a sky that has not seen the sun in a thousand years. Everything that ever fell has gathered here.","У витоку Дроту стоїть трон із мертвого каменю під небом, що не бачило сонця тисячу років. Усе, що колись упало, зібралося тут.")),
            wp_line(1,wp_tr("This is where the Wall Protocol began. Whatever you decide here, the Wire will obey. Survive first, warden. Then choose.","Тут почався Протокол Стіни. Яким би не було твоє рішення, Дріт підкориться. Спершу вистій, вартовий. Потім обирай.")),
            wp_line(2,wp_tr("I will not stop you from choosing. I only ask that you hear them first.","Я не завадю тобі обирати. Прошу лише спершу вислухати їх."))];
    }
    if(_kind=="epi") switch(_c) {
        case 0: return [
            wp_line(1,wp_tr("They are not routed. They are... withdrawing. As if someone called them back.","Вони не розбиті. Вони... відступають. Ніби хтось їх покликав.")),
            wp_line(2,wp_tr("Well held, warden. The light still burns. Enjoy it — it will not be for long.","Добре тримаєшся, вартовий. Світло ще горить. Милуйся ним — недовго лишилося.")),
            wp_line(1,wp_tr("That voice... I knew it once. The Wire is cut at Mirewood Ford. If it is not mended, this ward will stand alone until it falls.","Цей голос... Я колись його знав. Дріт перерізано біля Туманного Броду. Якщо його не полагодити, цей оберіг стоятиме сам, поки не впаде."))];
        case 1: return [
            wp_line(0,wp_tr("The relay-stone woke with a hum the marsh had not heard in a hundred years. Among the roots lay a warden's journal.","Камінь-ретранслятор прокинувся гулом, якого болото не чуло сто років. Серед коренів лежав щоденник вартового.")),
            wp_line(3,wp_tr("\"We lit the crystal with our own last breath. The Wall will hold, because we do not leave.\"","\"Ми запалили кристал власним останнім подихом. Стіна встоїть, бо ми не йдемо.\"")),
            wp_line(1,wp_tr("...Strange. I do not remember that line. Keep the journal, warden. Something in it troubles me.","...Дивно. Я не пам'ятаю цього рядка. Збережи щоденник, вартовий. Щось у ньому мене непокоїть."))];
        case 2: return [
            wp_line(2,wp_tr("Tell me, warden, did he ever say what your crystal is made of?","Скажи, вартовий, він колись казав, з чого зроблено твій кристал?")),
            wp_line(1,wp_tr("...She is right. I did not want to tell you. The crystals are not wells of earth-light. They are the first wardens — their souls, bound to the Wall to keep it burning. I am one of them.","...Вона має рацію. Я не хотів тобі казати. Кристали — не джерела земного світла. Це перші вартові — їхні душі, прив'язані до Стіни, щоб вона не гасла. Я — один із них.")),
            wp_line(3,wp_tr("How long?","Як довго?")),
            wp_line(1,wp_tr("Longer than anyone should be asked to stand a watch.","Довше, ніж будь-кого слід просити стояти на варті."))];
        case 3: return [
            wp_line(0,wp_tr("As the Colossus came apart, its bones whispered one word, over and over: rest.","Коли Колос розпадався, його кістки шепотіли одне слово, знову й знову: спочинок.")),
            wp_line(2,wp_tr("They are not destroyed, only scattered. That is my garrison, and it will gather again. It always does, until someone opens the gate.","Їх не знищено, лише розсіяно. Це мій гарнізон, і він збереться знову. Так буде завжди, доки хтось не відчинить браму.")),
            wp_line(2,wp_tr("Come to the Hollow Throne, where the Wire begins. There you may choose — if you dare to ask what the Wall truly is.","Приходь до Порожнього Трону, де починається Дріт. Там ти зможеш обрати — якщо наважишся запитати, чим насправді є Стіна.")),
            wp_line(1,wp_tr("It is a trap. And it is the truth. I cannot tell you which matters more.","Це пастка. І це правда. Я не можу сказати тобі, що важливіше."))];
        case 4: return [
            wp_line(0,wp_tr("The last Colossus fell. The dead stood motionless in the silence, waiting. The Wire hummed under the throne, and for the first time it asked a question.","Останній Колос упав. Мертві завмерли в тиші й чекали. Дріт гудів під троном, і вперше він поставив запитання.")),
            wp_line(1,wp_tr("It is your word now, warden. Keep the light, or let us go.","Тепер слово за тобою, вартовий. Зберегти світло чи відпустити нас."))];
    }
    if(_kind=="end") switch(_c) {
        case 1: return [
            wp_line(1,wp_tr("Then I will hold, and the others with me. It is a heavy duty, but the valley will wake to a sunrise.","Тоді я триматиму, і інші разом зі мною. Це важкий обов'язок, але долина прокинеться на світанку.")),
            wp_line(2,wp_tr("Then I will wait. I am very patient. I have had practice.","Тоді я чекатиму. Я дуже терпляча. У мене була практика.")),
            wp_line(0,wp_tr("The Wall burned bright, and the valley slept in safety. Somewhere in the dark a captain went on counting the dead who still stood watch.","Стіна палала яскраво, і долина спала в безпеці. Десь у темряві капітан і далі лічила мертвих, що досі стояли на варті.")),
            wp_line(4,wp_tr("THE WALL HOLDS","СТІНА ВИСТОЯЛА"))];
        case 2: return [
            wp_line(1,wp_tr("I can feel the knots coming undone... It is quiet. Thank you, warden.","Я відчуваю, як розв'язуються вузли... Тихо. Дякую, вартовий.")),
            wp_line(2,wp_tr("Rest now, all of you. Captain's orders.","Спочиньте тепер, усі. Наказ капітана.")),
            wp_line(0,wp_tr("The crystals went dark one by one, and one by one the dead lay down. At dawn — the first in a thousand years — the valley had no wall, no army and no ward. Only its people, and the sun.","Кристали згасали один за одним, і один за одним мерці лягали на спочинок. На світанку — першому за тисячу років — у долині не було ні стіни, ні війська, ні оберегу. Лише люди і сонце.")),
            wp_line(4,wp_tr("THE WATCH ENDS","ВАРТА ЗАВЕРШЕНА"))];
    }
    return [wp_line(0,"...")];
}
// Short line under the wave banner during a story battle ("" = default text).
function wp_wave_caption(_wave) {
    if(global.mode!=1)return "";
    switch(global.chapter) {
        case 0: switch(_wave) {
            case 1: return wp_tr("Orest: Scouts only. Learn the road before the real army arrives.","Орест: Лише розвідники. Вивчи дорогу, поки не прийшло справжнє військо.");
            case 3: return wp_tr("Orest: Runners! They want the core before the others arrive.","Орест: Бігуни! Вони хочуть дістатися ядра раніше за решту.");
            case 5: return wp_tr("Orest: That is everything they sent. Hold!","Орест: Це все, що вони послали. Тримайся!");
        } break;
        case 1: switch(_wave) {
            case 2: return wp_tr("Orest: Brutes. Slow, but they take blows like walls.","Орест: Громили. Повільні, але приймають удари, мов мури.");
            case 4: return wp_tr("Marena: Do you like my little garden, warden?","Марена: Подобається мій садочок, вартовий?");
            case 6: return wp_tr("Orest: The relay is catching! A little longer!","Орест: Ретранслятор розгорається! Ще трохи!");
        } break;
        case 2: switch(_wave) {
            case 2: return wp_tr("Orest: Runners ahead. The cold does not slow them.","Орест: Попереду бігуни. Холод їх не сповільнює.");
            case 4: return wp_tr("Marena: Every crystal has a voice. Have you heard yours?","Марена: У кожного кристала є голос. Ти чув свій?");
            case 6: return wp_tr("Orest: Do not listen to her. Build!","Орест: Не слухай її. Будуй!");
            case 7: return wp_tr("Orest: The last wave of the pass. Then the road opens.","Орест: Остання хвиля перевалу. Потім дорога відкриється.");
        } break;
        case 3: switch(_wave) {
            case 2: return wp_tr("Marena: They are not an army. They are a garrison coming to relieve their comrades.","Марена: Це не військо. Це гарнізон, що йде змінити своїх товаришів.");
            case 6: return wp_tr("Orest: The ground is shaking. Something very large is coming.","Орест: Земля здригається. Іде щось дуже велике.");
            case 8: return wp_tr("Orest: The Colossus! The first garrison, bone to bone.","Орест: Колос! Перший гарнізон, кістка до кістки.");
        } break;
        case 4: switch(_wave) {
            case 3: return wp_tr("Marena: Hear them, warden. Hear what you guard.","Марена: Послухай їх, вартовий. Послухай, що ти береш під захист.");
            case 5: return wp_tr("Orest: Another Colossus! Hold the line!","Орест: Ще один Колос! Тримай рубіж!");
            case 8: return wp_tr("Orest: The crystal is heavy... but I am still here.","Орест: Кристал важчає... але я ще тут.");
            case 10: return wp_tr("The Warden: One more time. Hold the line.","Вартовий: Ще раз. Тримай рубіж.");
        } break;
    }
    return "";
}
function wp_ending_name(_e) {
    return _e==1?wp_tr("The Wall holds","Стіна вистояла"):(_e==2?wp_tr("The watch ends","Варта завершена"):"");
}

// ------------------------------------------------------------------------------------------ progress file
function wp_story_default() { return {version:1,unlocked:1,stars:[0,0,0,0,0],times:[0,0,0,0,0],ending:0}; }
function wp_story_validate(_s) {
    if(!wp_fields(_s,["version","unlocked","stars","times","ending"]))return false;
    if(_s.version!=1||!wp_integer(_s.unlocked,1,WP_CHAPTERS)||!wp_integer(_s.ending,0,2))return false;
    if(!is_array(_s.stars)||array_length(_s.stars)!=WP_CHAPTERS||!is_array(_s.times)||array_length(_s.times)!=WP_CHAPTERS)return false;
    for(var _i=0;_i<WP_CHAPTERS;++_i) {
        if(!wp_integer(_s.stars[_i],0,3)||!wp_number(_s.times[_i],0,10000000))return false;
        // A chapter cannot be cleared before it was unlocked.
        if(_s.stars[_i]>0&&_s.unlocked<=_i)return false;
    }
    return true;
}
function wp_story_load() {
    global.story=wp_story_default();
    var _s=wp_read_json(global.file_prefix+"story.json");
    if(!wp_story_validate(_s))_s=wp_read_json(global.file_prefix+"story.bak");
    if(wp_story_validate(_s))global.story=_s;
}
function wp_story_save() {
    var _file=global.file_prefix+"story.json",_bak=global.file_prefix+"story.bak";
    // Keep the previous verified progress as a backup, like expedition saves.
    if(wp_story_validate(wp_read_json(_file))){if(file_exists(_bak))file_delete(_bak);file_copy(_file,_bak);}
    if(!wp_write_json(_file,global.story))wp_notice(wp_tr("Could not save story progress.","Не вдалося зберегти прогрес сюжету."));
}
// Called on a story victory: keeps the best result of the chapter and unlocks the next one.
function wp_story_record(_c,_stars,_time) {
    var _s=global.story;
    var _better=_stars>_s.stars[_c]||(_stars==_s.stars[_c]&&(_s.times[_c]<=0||_time<_s.times[_c]));
    if(_better){_s.stars[_c]=_stars;_s.times[_c]=_time;if(instance_exists(obj_game))obj_game.new_record=true;}
    _s.unlocked=max(_s.unlocked,min(WP_CHAPTERS,_c+2));
    wp_story_save();
}
function wp_story_unlock_all() {
    global.story.unlocked=WP_CHAPTERS;wp_story_save();
    wp_notice(wp_tr("All chapters unlocked (developer shortcut).","Усі розділи відкрито (шлях розробника)."));
}

// ------------------------------------------------------------------------------------------ flow
function wp_story_open() {
    global.story_sel=min(global.story.unlocked,WP_CHAPTERS)-1;
    global.return_page=global.page;
    wp_page("chapters");
}
// Starts a story chapter from the beginning. _skip=true jumps over the briefing (retry).
function wp_story_start(_chapter,_skip=false) {
    global.pending_load=undefined;global.resume_text=false;
    wp_rules_set(1,clamp(_chapter,0,WP_CHAPTERS-1));
    global.skip_brief=_skip;
    wp_room_goto(rm_game);
}
// After the result screen of a won chapter: epilogue, then the next chapter (or the final choice).
function wp_story_epilogue() {
    if(!instance_exists(obj_game)||global.mode!=1||obj_game.result!=1)return;
    wp_cutscene_start("epi",global.chapter,wp_story_lines("epi",global.chapter));
}
function wp_story_choose(_ending) {
    global.story.ending=clamp(_ending,1,2);wp_story_save();
    wp_cutscene_start("end",WP_CHAPTERS-1,wp_story_lines("end",_ending));
}

// ------------------------------------------------------------------------------------------ cutscenes
// Breaks a text into lines of at most _width pixels (fnt_ui) so a typewriter effect never re-flows words.
function wp_wrap_text(_text,_width) {
    draw_set_font(fnt_ui);
    var _out="",_line="",_rest=_text;
    while(string_length(_rest)>0) {
        var _p=string_pos(" ",_rest);
        var _word=_p>0?string_copy(_rest,1,_p-1):_rest;
        _rest=_p>0?string_delete(_rest,1,_p):"";
        var _try=_line==""?_word:_line+" "+_word;
        if(string_width(_try)>_width&&_line!=""){_out+=_line+"\n";_line=_word;}
        else _line=_try;
    }
    return _out+_line;
}
function wp_cutscene_set_line() {
    var _c=global.cutscene,_l=_c.lines[_c.i];
    _c.text=_l.who==4?_l.text:wp_wrap_text(_l.text,960);
    _c.len=string_length(_c.text);_c.chars=0;
}
function wp_cutscene_start(_kind,_chapter,_lines) {
    global.cutscene={kind:_kind,chapter:_chapter,lines:_lines,i:0,chars:0,text:"",len:0,t:0,done:false};
    wp_cutscene_set_line();
    wp_page("story");
}
function wp_cutscene_end() {
    var _c=global.cutscene;
    // Room changes fade out over several frames; the scene must not react to input or index past its last line meanwhile.
    if(_c.done)return;
    _c.done=true;
    _c.i=clamp(_c.i,0,array_length(_c.lines)-1);
    switch(_c.kind) {
        case "brief":wp_page("game");wp_sound(snd_horn,.6);break;
        case "epi":
            if(_c.chapter>=WP_CHAPTERS-1)wp_page("choice");
            else wp_story_start(_c.chapter+1,false);
            break;
        case "end":
            global.pending_load=undefined;
            wp_notice(wp_tr("Story complete. Thank you for standing the watch.","Сюжет завершено. Дякуємо, що стояли на варті."));
            wp_room_goto(rm_menu);
            break;
    }
}
function wp_cutscene_advance() {
    var _c=global.cutscene;
    if(_c.done)return;
    if(_c.chars<_c.len){_c.chars=_c.len;return;}
    if(_c.i+1>=array_length(_c.lines)){wp_cutscene_end();return;}
    _c.i++;
    wp_cutscene_set_line();
    wp_sound(snd_hover,.6);
}
// Per-frame input and typewriter, called from obj_app while the "story" page is shown.
function wp_cutscene_step(_dt) {
    var _c=global.cutscene;
    _c.t+=_dt;
    if(_c.done)return;
    if(_c.chars<_c.len)_c.chars=min(_c.len,_c.chars+_dt*(_c.lines[_c.i].who==4?16:55));
    if(keyboard_check_pressed(vk_escape)){wp_cutscene_end();return;}
    if(_c.t>.4&&(mouse_check_button_pressed(mb_left)||keyboard_check_pressed(vk_space)||keyboard_check_pressed(vk_enter)))wp_cutscene_advance();
}
function wp_cutscene_draw() {
    var _c=global.cutscene,_l=_c.lines[clamp(_c.i,0,array_length(_c.lines)-1)],_sp=wp_speaker(_l.who);
    var _scene=[spr_scene_0,spr_scene_1,spr_scene_2,spr_scene_3,spr_scene_4][clamp(_c.chapter,0,WP_CHAPTERS-1)];
    var _fade=clamp(_c.t/.7,0,1);
    draw_set_color(c_black);draw_rectangle(0,0,WP_W,WP_H,false);
    // Slowly drifting scene, fog and floating sparks in the speaker's colour.
    var _zoom=1.07+.025*sin(global.ui_time*.12),_w=WP_W*_zoom,_h=WP_H*_zoom;
    draw_sprite_stretched_ext(_scene,0,(WP_W-_w)/2+sin(global.ui_time*.08)*20,(WP_H-_h)/2+cos(global.ui_time*.06)*8,_w,_h,c_white,_fade);
    if(global.effects) {
        draw_sprite_tiled_ext(spr_mist,0,global.ui_time*10,global.ui_time*2,2.4,2.4,make_color_rgb(150,170,185),.12*_fade);
        for(var _i=0;_i<30;++_i) {
            var _px=(_i*131+global.ui_time*(6+_i mod 5))mod WP_W,_py=WP_H-((_i*79+global.ui_time*(9+_i mod 4))mod 560);
            wp_glow(_px,_py,6+2*sin(global.ui_time+_i),_sp.color,(.25+.15*sin(global.ui_time*.9+_i))*_fade);
        }
    }
    draw_sprite_stretched_ext(spr_vignette,0,0,0,WP_W,WP_H,c_black,.7*_fade);
    // Chapter heading (kept while the briefing / epilogue runs).
    if(_c.kind!="end") {
        var _head=(_c.kind=="brief"?wp_tr("CHAPTER ","РОЗДІЛ "):wp_tr("CHAPTER ","РОЗДІЛ "))+wp_roman(_c.chapter)+(_c.kind=="epi"?wp_tr("  /  COMPLETE","  /  ПРОЙДЕНО"):"");
        wp_text_a(80,60,_head,fnt_ui,global.col.gold,fa_left,_fade);
        wp_text_a(80,86,wp_chapter_title(_c.chapter),fnt_heading,global.col.text,fa_left,_fade);
    }
    var _shown=string_copy(_c.text,1,floor(_c.chars));
    if(_l.who==4) {
        // Title card: centred, large.
        wp_glow(683,352,260,global.col.gold,.14*_fade);
        wp_text_a(683,326,_shown,fnt_title,global.col.gold,fa_center,_fade);
        wp_text_a(1220,716,wp_tr("Click: continue","Клік: далі"),fnt_ui,global.col.muted,fa_right,_fade);
        return;
    }
    // Dialogue panel with a rune sigil in the speaker's colour.
    wp_panel(120,548,1126,170,.93*_fade);
    wp_glow(186,608,70,_sp.color,.30*_fade);
    gpu_set_blendmode(bm_add);
    draw_sprite_ext(spr_runering,0,186,608,.5,.5,global.ui_time*14,_sp.color,.85*_fade);
    gpu_set_blendmode(bm_normal);
    wp_text_a(240,566,_sp.name,fnt_heading,_sp.color,fa_left,_fade);
    wp_text_a(240,612,_shown,fnt_ui,global.col.text,fa_left,_fade);
    var _n=array_length(_c.lines);
    for(var _d=0;_d<_n;++_d) {
        draw_set_color(_d<=_c.i?_sp.color:global.col.line);draw_set_alpha(_fade);
        draw_rectangle(240+_d*16,698,240+_d*16+10,702,false);
    }
    draw_set_alpha(1);
    if(_c.chars>=_c.len&&frac(global.ui_time*1.4)<.7)wp_text_a(1220,690,wp_tr("Click / Space  >","Клік / Пробіл  >"),fnt_ui,global.col.gold,fa_right,_fade);
    wp_text_a(1220,664,wp_tr("Esc: skip","Esc: пропустити"),fnt_ui,global.col.muted,fa_right,_fade);
}

// ------------------------------------------------------------------------------------------ chapter select screen
function wp_chapters_draw() {
    var _a=global.overlay_t,_sel=clamp(global.story_sel,0,WP_CHAPTERS-1),_s=global.story,_open=_sel<_s.unlocked;
    wp_panel(170,84,1026,600,.98*_a);
    wp_text_a(683,104,wp_tr("STORY MODE","СЮЖЕТНИЙ РЕЖИМ"),fnt_heading,global.col.gold,fa_center,_a);
    wp_text_a(683,146,wp_tr("Five wards. Five nights. One choice.","П'ять оберегів. П'ять ночей. Один вибір."),fnt_ui,global.col.muted,fa_center,_a);
    var _scenes=[spr_scene_0,spr_scene_1,spr_scene_2,spr_scene_3,spr_scene_4];
    draw_sprite_stretched_ext(_scenes[_sel],0,668,186,492,277,_open?c_white:make_color_rgb(60,66,80),_a);
    draw_set_color(global.col.line);draw_set_alpha(_a);draw_rectangle(668,186,1160,463,true);draw_set_alpha(1);
    if(!_open) {
        wp_text_a(914,300,wp_tr("LOCKED","ЗАБЛОКОВАНО"),fnt_heading,global.col.muted,fa_center,_a);
        wp_text_a(914,340,wp_tr("Clear chapter "+string(_sel)+" first.","Спершу пройдіть розділ "+string(_sel)+"."),fnt_ui,global.col.muted,fa_center,_a);
    } else {
        var _rules=wp_rules_for(1,_sel);
        wp_text_a(668,472,wp_roman(_sel)+"   "+wp_chapter_title(_sel),fnt_ui,global.col.gold,fa_left,_a);
        wp_text_a(668,496,wp_tr("Map: ","Карта: ")+wp_map_name(_rules.map)+"   /   "+string(_rules.total)+wp_tr(" waves"," хвиль")+(array_length(_rules.boss)>0?wp_tr("   /   Colossus"," / Колос"):""),fnt_ui,global.col.muted,fa_left,_a);
        if(_s.stars[_sel]>0) {
            draw_set_alpha(_a);wp_stars(1096,481,_s.stars[_sel],8);draw_set_alpha(1);
            wp_text_a(1160,496,wp_tr("Best ","Рекорд ")+wp_clock(_s.times[_sel]),fnt_ui,global.col.gold,fa_right,_a);
        }
        wp_wrap(668,526,wp_chapter_blurb(_sel),492);
    }
    if(_s.ending>0)wp_text_a(206,556,wp_tr("Ending reached: ","Досягнуто фінал: ")+wp_ending_name(_s.ending),fnt_ui,global.col.gold,fa_left,_a);
}
