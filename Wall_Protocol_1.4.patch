+    todo = []
+    for name, n in m['decor'].items():
+        todo += [KIND[name]] * n
+    rnd.shuffle(todo)
+    for kind in todo:
+        r = SPR_R[kind]
+        for _try in range(600):
+            x, y = rnd.randint(25, 1040), rnd.randint(90, 690)
