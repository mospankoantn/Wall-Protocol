+# --------------------------------------------------------------------------------------------- geometry
+def seg_dist(p, a, b):
+    ax, ay = a; bx, by = b; px, py = p
+    dx, dy = bx - ax, by - ay
+    sq = dx * dx + dy * dy
+    t = 0 if sq == 0 else max(0, min(1, ((px - ax) * dx + (py - ay) * dy) / sq))
+    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))
+
+
+def route_dist(p, route):
+    return min(seg_dist(p, route[i], route[i + 1]) for i in range(len(route) - 1))
+
