@@ -0,0 +1,38 @@
+/// GENERATED by tools/story_maps.py - edit the tool, not this file.
+/// Map 0 is the room-authored forest map; maps 1-4 are applied over the room by wp_map_apply().
+function wp_map_count() { return 5; }
+
+function wp_map_name(_id) {
+    switch(_id) {
+        case 0: return wp_tr("The Ward Road","Дорога Оберегу");
+        case 1: return wp_tr("Mirewood Ford","Туманний Брід");
+        case 2: return wp_tr("Frostline Pass","Крижаний Перевал");
+        case 3: return wp_tr("Ashen Citadel","Попелясте Місто");
+        case 4: return wp_tr("The Hollow Throne","Порожній Трон");
+    }
+    return "?";
+}
+
+/// Layout of a generated map: route nodes, pad positions, decor [kind,x,y], core and portal.
